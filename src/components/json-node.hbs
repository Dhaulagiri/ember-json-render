{{#if this.containerVisible}}
  {{#if this.component}}
    {{#let this.component as |CatalogComponent|}}
      {{#if this.element.repeat}}
        {{#each this.repeated key="@index" as |item index|}}
          {{#if (this.visibleFor item index)}}
            <CatalogComponent
              @props={{this.propsFor item index (this.repeatBaseAt index)}}
              @state={{@state}}
              @emit={{this.emit}}
              @children={{this.children}}
              @bindings={{this.bindingsFor item index (this.repeatBaseAt index)}}
              @item={{item}}
              @index={{index}}
              @bind={{(fn this.bindFor item index (this.repeatBaseAt index))}}
            >
              {{#each this.children as |childKey|}}
                <JsonNode @elementKey={{childKey}} @spec={{@spec}} @registry={{@registry}} @state={{@state}} @store={{@store}} @emit={{@emit}} @loading={{@loading}} @item={{item}} @index={{index}} @repeatBasePath={{(this.repeatBaseAt index)}} />
              {{/each}}
            </CatalogComponent>
          {{/if}}
        {{/each}}
      {{else}}
        <CatalogComponent
          @props={{this.props}}
          @state={{@state}}
          @emit={{this.emit}}
          @children={{this.children}}
          @bindings={{this.bindings}}
          @bind={{this.bind}}
        >
          {{#each this.children as |childKey|}}
            <JsonNode @elementKey={{childKey}} @spec={{@spec}} @registry={{@registry}} @state={{@state}} @store={{@store}} @emit={{@emit}} @loading={{@loading}} />
          {{/each}}
        </CatalogComponent>
      {{/if}}
    {{/let}}
  {{else if @loading}}
    <span class="jr-missing" data-jr-key={{@elementKey}}>Loading…</span>
  {{/if}}
{{/if}}
