{
  "name": "ember-json-render",
  "version": "0.1.0",
  "description": "Render json-render UI specs with Ember and Glimmer components",
  "type": "module",
  "keywords": [
    "ember-addon",
    "json-render",
    "generative-ui",
    "glimmer"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@glimmer/component": "^2.0.0",
    "@json-render/core": "^0.23.0",
    "ember-source": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-typescript": "^7.29.0",
    "@embroider/addon-dev": "^8.0.0",
    "@glint/template": "^1.5.0",
    "@rollup/plugin-babel": "^6.0.4",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "rollup": "^4.6.0",
    "typescript": "^5.7.0",
    "@changesets/cli": "^2.27.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup --config",
    "prepack": "rollup --config",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.0"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs"
  }
}
